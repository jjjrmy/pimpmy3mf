// Cloudflare Worker: serves the built app (Workers Static Assets) and one small API route,
// /api/filaments (filamentcolors.xyz swatches, slimmed + edge-cached 24 h; see worker/index.ts).
// All image -> 3D processing happens in the browser; nothing is uploaded.
//   bun run worker:dev    build + wrangler dev (local)
//   bun run deploy        build + wrangler deploy (account comes from `wrangler login`)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pimpmy3mf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // the worker runs first for every request: it serves /api/*, redirects www -> apex, then hands off to assets
    "run_worker_first": true
  },
  // keep the *.workers.dev URL alongside the custom domains
  "workers_dev": true,
  "routes": [
    { "pattern": "pimpmy3mf.app", "custom_domain": true },
    { "pattern": "www.pimpmy3mf.app", "custom_domain": true }
  ]
}
